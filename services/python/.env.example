ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_ONLY_SECRET
# Legacy fallback only:
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Only for legacy/local HS256 projects:
# SUPABASE_JWT_SECRET=

# Start with fake for a no-cost deterministic deployment test.
EXTRACTION_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

WORKER_NAME=pajara-worker
WORKER_POLL_SECONDS=2
CODE_VERSION=0.1.0
